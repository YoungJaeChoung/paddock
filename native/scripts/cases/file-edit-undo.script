mem undone-1mib
# 저장: 맨 앞에 `Z`를 더해 저장하면 디스크 바이트는 `Z` + 원래 바이트(CRLF 그대로)다.
key Z
waitstate unsaved=yes @3000
mark save-1mib
key ctrl-s
waitstate unsaved=no @10000
send $a = [IO.File]::ReadAllBytes("$env:USERPROFILE\\proj-edit\\a-1mib.ts"); $o = (Get-FileHash "$env:USERPROFILE\\proj-edit\\zz-orig.txt").Hash; $t = (Get-FileHash -InputStream ([IO.MemoryStream]::new($a, 1, $a.Length - 1))).Hash; if ($a[0] -eq 90 -and $a.Length -eq 1048577 -and $t -eq $o) { Write-Host ("SA" + "ME-1MIB") } else { Write-Host ("DI" + "FF-1MIB " + $a.Length) }\r
waitline SAME-1MIB @60000
# 512 KiB(강조) 열기.
act resetgap
act openfile 2
waitstate language=typescript @20000
act focusfile
mark opened-512k
state opened-512k
