# S6 스파이크(편집 모드): 1 MiB·512 KiB 파일 열기 시간, 200글자 입력 동안 창 스레드 지연(`ui-max-gap-ms`), Ctrl+Z 100번 뒤 내용 해시 복귀, 편집 모드 메모리.
# 열기 시간은 `act openfile` 직후 `waitstate`의 "found after N ms" 줄이다. 실행기가 임시 홈에 기본 셸을 PowerShell로 둬야 한다.
waittabs 1 @30000
waitstate cwd=C: @30000
mem start
send $p = "$env:USERPROFILE\\proj-edit"; mkdir $p, "$env:USERPROFILE\\bin" -Force | Out-Null; $line = "export const value = 'a long enough line of source text to fill the file quickly';`r`n"; $big = $line * [math]::Ceiling(1048576 / $line.Length); [IO.File]::WriteAllText("$p\\a-1mib.ts", $big.Substring(0, 1048576)); [IO.File]::WriteAllText("$p\\b-512k.ts", $big.Substring(0, 524288)); Copy-Item "$p\\a-1mib.ts" "$p\\zz-orig.txt"; Copy-Item C:\\Windows\\System32\\PING.EXE "$env:USERPROFILE\\bin\\claude.exe"; cd $p\r
send echo READY-EDIT\r
waitline READY-EDIT @30000
send claude.exe -n 600 127.0.0.1\r
waitstate program=claude @20000
waitstate row folder @20000
waitstate files-loaded=true @10000
key ctrl-shift-c
waittabs 2 @20000
wait 1500
mem before-open
# 행: a-1mib.ts · b-512k.ts. 1 MiB 열기(강조 없음).
act resetgap
act openfile 1
waitstate file-view kind=text state=text @20000
act focusfile
mark opened-1mib
state opened-1mib
wait 3000
mem edit-1mib-3s
state before-typing
# 놀고 있을 때의 바닥값을 먼저 잰다(`ui-max-gap-ms`는 16 ms 타이머의 두 틱이 들어가 놀아도 30 ms쯤 나온다).
act resetgap
wait 3000
state idle-1mib
# 첫 글자(편집 기록·줄 배치가 처음 만들어지는 비용)와 이어 치는 글자를 따로 잰다.
act resetgap
key Z
wait 2000
state first-char
# 200글자를 한 글자씩(키 하나가 다음 갱신 한 번에 처리됨) 입력하는 동안 창 스레드 지연.
