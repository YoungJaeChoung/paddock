# (1/2) 묶음 둘을 각각 분할(옆·아래)하고 비율을 바꾼 뒤 전환 → 복귀 → 앱 종료·재실행. 비율·선택·셸 pid가 그대로여야 한다
waittabs 1 @30000
send echo A1\r
waitline A1 @20000
key ctrl-shift-c
waittabs 2 @20000
wait 1500
act setsplit - 3 7
state a-split
# 두 번째 묶음
act workadd
waittabs 3 @20000
wait 1500
send echo B1\r
waitline B1 @20000
key ctrl-shift-`
waittabs 4 @20000
wait 1500
act setsplit - 2 8
state b-split
shot b-split
# 묶음 A로 갔다 돌아온다
act selectgroup 1
wait 800
state back-in-a
shot back-in-a
act selectgroup 2
wait 800
state back-in-b
daemonlist before-restart
closewindow
waitoverlay quit @5000
key enter
wait 3000
