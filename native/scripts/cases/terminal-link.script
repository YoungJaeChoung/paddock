# 터미널 경로 링크 (D56 · 1단계가 미룬 항목): 화면에 찍힌 경로 글자가 실제 파일을 가리키면 `term-link <터미널> <경로> <줄>` 줄이 생기고,
# `act termlink N`(Ctrl+클릭과 같은 열기)이 파일 탭을 열어 줄 번호가 있으면 그 줄로 간다. 없는 경로·폴더·문장 끝 마침표·`~` 하나는 링크가 아니다.
# 실제 마우스 Ctrl+올림·Ctrl+클릭은 자동 점검으로 흉내 낼 수 없어 야간 묶음에서 사람 손으로 확인한다. 임시 홈에 prep-link.sh로 proj-link를 채우고 기본 셸을 PowerShell로 둔다.
waittabs 1 @30000
waitstate cwd=C: @30000
send $p = "$env:USERPROFILE\\proj-link"; Copy-Item C:\\Windows\\System32\\PING.EXE "$env:USERPROFILE\\bin\\claude.exe"; cd $p\r
send echo READY-LINK\r
waitline READY-LINK @20000
send claude.exe -n 300 127.0.0.1\r
waitstate program=claude @20000
waitstate row folder @20000
waitstate files-loaded=true @10000
key ctrl-shift-c
waittabs 2 @20000
wait 1500
send while ($true) { $k = [Console]::ReadKey($true); Write-Host ("GOT-" + [int]$k.Key) }\r
wait 1500
# 터미널 1은 claude(ping)가 돌고 있어 입력을 받지 않는다. 링크를 찍을 새 터미널(셋째)을 연다.
key ctrl-shift-t
waittabs 3 @20000
wait 1500
send echo src/a.js:12\r
waitline src/a.js:12 @20000
wait 800
state link-found
waitstate /src/a.js 12 @10000
# 같은 줄 번호로 파일 탭이 열린다.
act termlink 1
waitstate file-view kind=text state=text @10000
waitstate line=12 @10000
wait 1000
state link-opened
shot link-opened
# 같은 파일을 다른 철자(역슬래시)로 열어도 탭은 하나다: 역슬래시 철자의 탭 줄이 생기지 않는다.
act openpath C:\Temp\pdk-run\home-terminal-link\proj-link\src\a.js
wait 1000
state link-same-tab
waitnostate text C:\Temp @5000
# 없는 경로·폴더·문장 끝 마침표·홈의 `~` 하나는 링크가 아니다. 상대 경로(docs/guide.md)와 `~/notes-link.md`는 링크다.
act closefile
send cls\r
wait 800
send echo "src/nope.js:5 src/ ok. . .. ~"\r
waitline src/nope.js:5 src/ ok. . .. ~ @20000
wait 800
state link-none
waitnostate term-link @10000
# 공유 주소(\\\\호스트\\공유)는 링크가 아니다(올려 보기만으로 네트워크 접속이 일어나지 않게).
send cls\r
wait 800
send echo "\\\\unc-host-x\\share\\a.js"\r
waitline \\unc-host-x\share\a.js @20000
wait 800
state link-unc
waitnostate term-link @10000
send cls\r
wait 800
send cls\r
wait 800
send echo "docs/guide.md ~/notes-link.md."\r
waitline docs/guide.md ~/notes-link.md. @20000
wait 800
state link-two
waitstate docs/guide.md - @10000
waitstate notes-link.md - @10000
# 명령 줄의 `~/notes-link.md`는 줄이 접혀 두 토막이 되어 링크가 아니고, 출력 줄의 것(셋째)이 홈의 파일을 연다.
act termlink 3
waitstate notes-link.md selected shown @10000
wait 800
state link-home-opened
# 미리보기로 열리는 Markdown에 줄 번호가 붙은 링크가 오면 원문 보기(view=file)로 바뀌어 그 줄로 스크롤된다(scroll-y가 0이 아니다).
send cls\r
wait 800
send echo "docs/guide.md:40"\r
waitline docs/guide.md:40 @20000
wait 800
state link-md-line
waitstate docs/guide.md 40 @10000
# 명령 줄의 것(첫째)은 줄 번호 없이 풀리고, 출력 줄의 것(둘째)이 40번째 줄을 가리킨다.
act termlink 2
waitstate view=file @10000
waitnostate scroll-y=0 @10000
wait 800
state link-md-line-opened
dumptab 2 pty-after-links
nolinestart 2 GOT-#
quit
