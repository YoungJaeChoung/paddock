# 분리 창(덩어리 36): Move to New Window → 같은 터미널(셸 pid·격자)이 분리 창에 있고, 본 창 탭 줄에 흐린 탭·Work 행 other window 표지가 남는다.
# 분리 창 닫기는 탭을 첫 칸 끝으로 되돌리고, 분리 창에서 닫은 터미널은 창도 함께 닫힌다.
waittabs 1 @30000
send echo T-ONE\r
waitline T-ONE @20000
key ctrl-shift-t
waittabs 2 @20000
key ctrl-shift-t
waittabs 3 @20000
sendto 2 echo T-TWO-BEFORE\r
wait 1500
state before
shot before
act selecttab 2
act movetowindow 2
waitstate detached=2 @10000
waitstate dwin 2 title=terminal 2 @5000
waitstate strip col0 tabs=1,3,2:faded @5000
waitstate group root=1 name=terminal 1 n=3 last_used=2 meta=other_window @5000
state detached
shot main-detached
shotwin 2 detached-window
# 같은 터미널이 분리 창에서 계속 돈다(같은 격자에 새 출력이 쌓이고, 셸 pid는 그대로다)
sendto 2 echo HI-FROM-DETACHED\r
wait 1500
dumptab 2 detached-grid
# Work 행 other window를 누른 것과 같은 동작: 그 창을 앞으로 가져오라는 요청이 1번 쌓이고 본 창의 선택은 그대로다
act selectgroup 1
waitstate activations=1 unseen @5000
state activated
# 더블클릭(이름 바꾸기)은 분리 창이 아니라 본 창을 앞으로 가져오고 입력칸은 본 창에 열린다: 분리 창 활성 요청은 첫 클릭의 1번만 더해진다
act dblclick terminal 2
waitoverlay rename @5000
waitstate main-activations=1 @3000
waitstate activations=2 unseen @3000
state dblclick
shot dblclick-rename
act cancel
waitoverlay none @5000
# 분리 창 닫기 = 되돌리기: 첫 칸 끝으로 돌아온다
act windowclose 2
waitstate detached=- @10000
waitstate strip col0 tabs=1,3,2 @5000
state back
shot main-back
# 다시 분리한 뒤 셸을 끝내면 닫는 길(분리 창 ×)이 바로 닫는다(끝난 터미널은 묻지 않는다)
act movetowindow 2
waitstate detached=2 @10000
sendto 2 exit\r
wait 2000
shotwin 2 detached-exited
act detachedclose 2
waittabs 2 @10000
waitstate detached=- @10000
state closed
shot main-closed
act quick quitstop
wait 3000
