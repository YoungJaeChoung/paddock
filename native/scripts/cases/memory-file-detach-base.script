# 파일 분리 창 메모리(덩어리 38) 비교 기준(분리 없이 같은 시간을 쉰다): 텍스트 편집기·PDF를 연 채 열기 전 → 분리(설계 크기 900×600) → 20초 → 되돌림 → 20초 → 열고 닫기 10회 → 20초. 각 단계에서 Private 메모리와 그래픽 몫을 잰다.
# 실행기가 임시 홈에 prep-fd.sh로 proj-fdp 폴더를 채우고 기본 셸을 PowerShell로 둔다.
waittabs 1 @30000
waitstate cwd=C: @30000
send $p = "$env:USERPROFILE\\proj-fdp"; Set-Content "$p\\notes.txt" ((1..400 | ForEach-Object { "line $_ of the notes file" }) -join "`n"); cd $p\r
send echo MEM-FD\r
waitline MEM-FD @20000
act openpath C:/Temp/pdk-run/home-memory-file-detach-base/proj-fdp/notes.txt
waitstate kind=text state=text @10000
act openpath C:/Temp/pdk-run/home-memory-file-detach-base/proj-fdp/sample-3p.pdf
waitstate kind=pdf state=pdf pages=3 @15000
wait 20000
mem before-detach
gpumem before-detach
wait 20000
mem text-open
gpumem text-open
wait 20000
mem text-back
gpumem text-back
wait 20000
mem pdf-open
gpumem pdf-open
wait 20000
mem pdf-back
gpumem pdf-back
wait 25000
wait 20000
mem after-10
gpumem after-10
act quick quitstop
wait 3000
