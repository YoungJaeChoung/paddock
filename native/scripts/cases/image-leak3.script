# 4K 이미지를 열고 1:1로 바꿨다 맞춤으로 돌아와 닫기를 8번 반복하며 매번 닫은 뒤 앱 Private 메모리를 잰다(원본 크기를 다시 읽는 비용이 누적되는지). 실행 이름은 image-leak3다.
waittabs 1 @30000
waitstate cwd=C: @30000
send echo READY-LEAK\r
waitline READY-LEAK @30000
wait 3000
mem baseline
act openpath C:/Temp/pdk-run/home-image-leak3/proj-md/g-4k.png
waitstate kind=image state=image @20000
wait 1500
act imgzoom
waitstate full=yes @20000
wait 1500
act imgzoom
waitstate full=no @5000
wait 1000
act closefile
wait 3000
mem c1
act openpath C:/Temp/pdk-run/home-image-leak3/proj-md/g-4k.png
waitstate kind=image state=image @20000
wait 1500
act imgzoom
waitstate full=yes @20000
wait 1500
act imgzoom
