# 동기화 ① Work 목록: 터미널 행 더블클릭 이름 바꾸기, 행 끌어 순서 바꾸기(같은 폴더만), 폴더 메뉴 `Reveal folder` 항목,
# `Show to the Side`(터미널 id·셸 프로세스·출력이 그대로), 칸 ＋(그 칸에 새 터미널). 폴더 안 터미널 셋을 만든 뒤 시작한다.
# 실행기가 임시 홈의 네이티브 설정에 기본 셸을 PowerShell로 둬야 한다.
waittabs 1 @30000
waitstate cwd=C: @30000
send $p = "$env:USERPROFILE\\proj-sync"; mkdir $p, "$env:USERPROFILE\\bin" -Force | Out-Null; Copy-Item C:\\Windows\\System32\\PING.EXE "$env:USERPROFILE\\bin\\claude.exe"; cd $p\r
send echo READY-SYNC\r
waitline READY-SYNC @20000
send claude.exe -n 900 127.0.0.1\r
waitstate program=claude @20000
waitstate row folder @20000
key ctrl-shift-t
waittabs 2 @20000
key ctrl-shift-t
waittabs 3 @20000
wait 1500
state three-terminals
# 더블클릭: 첫 누름은 선택만, 두 번째 누름은 이름 바꾸기 창을 연다.
act selecttab 1
wait 500
state single-click-selects
act dblclick terminal 2
waitoverlay rename @5000
state double-click-rename
shot double-click-rename
act cancel
waitoverlay none @5000
# 행 끌기: 1번 행을 3번 행 뒤로. 다른 폴더가 없으므로 같은 폴더 안 순서만 바뀐다. 순서는 state.json에도 남는다.
act dragrow 1 3 after
wait 800
state dragged-after
files dragged-after
act dragrow 3 2 before
wait 800
state dragged-before
# 폴더 메뉴에 Reveal folder 항목이 있다(실행은 파일 관리자를 띄우므로 야간에서 한다).
act menu folder 1
waitstate menu: folder @5000
state folder-menu
shot folder-menu
key escape
waitstate menu: none @5000
# Show to the Side: 선택한 터미널(3번)이 기준이다. 1번 터미널을 옆 칸으로 옮겨도 터미널은 하나도 새로 생기거나 사라지지 않는다.
act menu terminal 1
waitstate menu-item 2 Show to the Side @5000
shot terminal-menu
key escape
waitstate menu: none @5000
state before-beside
act showbeside 1
wait 1500
state after-beside
shot after-beside
sendto 1 echo STILL-ALIVE\r
wait 1000
dumptab 1 moved-terminal
# 칸 ＋: 둘째 칸의 ＋는 그 칸에 새 터미널을 탭으로 더한다(등록 계정이 없으면 메뉴 없이 바로).
act paneadd 2
waittabs 4 @20000
wait 1500
state pane-added
shot pane-added
quit
