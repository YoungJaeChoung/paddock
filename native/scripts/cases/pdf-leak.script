wait 1500
act closefile
wait 2500
act openpath C:/Temp/pdk-run/home-pdf-leak/proj-pdf/many-300p.pdf
waitstate kind=pdf state=pdf pages=300 @20000
wait 2500
act pdfscroll 40
wait 1500
act closefile
wait 2500
act openpath C:/Temp/pdk-run/home-pdf-leak/proj-pdf/many-300p.pdf
waitstate kind=pdf state=pdf pages=300 @20000
wait 2500
act pdfscroll 40
wait 1500
act closefile
wait 2500
act openpath C:/Temp/pdk-run/home-pdf-leak/proj-pdf/many-300p.pdf
