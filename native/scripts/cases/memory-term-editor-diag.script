# 편집기가 본 창에 열려 있을 때 터미널 분리 창의 열림이 +18/+63으로 갈리는지 본다(덩어리 39 진단): 텍스트 파일을 연 채 터미널 2를 900×600 분리 창으로 4번 열고 닫는다. 임시 홈 이름 memory-text-diag.
waittabs 1 @30000
waitstate cwd=C: @30000
send $p = "$env:USERPROFILE\\proj-fdp"; Set-Content "$p\\notes.txt" ((1..400 | ForEach-Object { "line $_ of the notes file" }) -join "`n"); cd $p\r
send echo MEM-TD\r
waitline MEM-TD @20000
act openpath C:/Temp/pdk-run/home-memory-text-diag/proj-fdp/notes.txt
waitstate kind=text state=text @15000
wait 15000
mem d-before
gpumem d-before
key ctrl-shift-t
waittabs 2 @20000
act selecttab 1
wait 3000
act detachsize 900 600
act movetowindow 2
waitstate detached=2 @10000
wait 10000
mem d-open-1
gpumem d-open-1
act moveback 2
waitstate detached=- @10000
wait 10000
mem d-back-1
gpumem d-back-1
act movetowindow 2
waitstate detached=2 @10000
wait 10000
mem d-open-2
gpumem d-open-2
act moveback 2
waitstate detached=- @10000
wait 10000
mem d-back-2
gpumem d-back-2
act movetowindow 2
waitstate detached=2 @10000
wait 10000
mem d-open-3
gpumem d-open-3
act moveback 2
waitstate detached=- @10000
wait 10000
mem d-back-3
gpumem d-back-3
act movetowindow 2
waitstate detached=2 @10000
wait 10000
mem d-open-4
gpumem d-open-4
act moveback 2
waitstate detached=- @10000
wait 10000
mem d-back-4
gpumem d-back-4
wait 40000
mem d-final
gpumem d-final
quit
