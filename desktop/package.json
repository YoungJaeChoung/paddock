{
  "private": true,
  "name": "paddock-desktop",
  "version": "0.1.0",
  "main": "lib/backend/electron-main.js",
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "Paddock",
        "defaultTheme": "dark",
        "preferences": {
          "workbench.colorTheme": "Paddock Dark",
          "terminal.integrated.fontFamily": "Consolas, Menlo, 'Droid Sans Mono', 'DejaVu Sans Mono', 'Malgun Gothic', 'Apple SD Gothic Neo', 'Noto Sans Mono CJK KR', monospace",
          "terminal.integrated.letterSpacing": 0,
          "terminal.integrated.lineHeight": 1.1,
          "editor.fontFamily": "Consolas, Menlo, 'Droid Sans Mono', 'DejaVu Sans Mono', 'Malgun Gothic', 'Apple SD Gothic Neo', 'Noto Sans Mono CJK KR', monospace",
          "editor.enablePreview": false,
          "editor.wordWrap": "on",
          "workbench.tree.indent": 20,
          "files.exclude": {
            "**/.git": true,
            "**/.svn": true,
            "**/.hg": true,
            "**/CVS": true,
            "**/.DS_Store": true,
            "**/Thumbs.db": true,
            "**/__pycache__": true
          },
          "git.autofetch": true,
          "window.titleBarStyle": "custom",
          "window.title": "${appName}",
          "terminal.integrated.profiles.linux": {
            "bash": {
              "path": "/bin/bash",
              "args": [
                "-l"
              ]
            },
            "zsh": {
              "path": "/usr/bin/zsh",
              "args": [
                "-l"
              ]
            },
            "fish": {
              "path": "/usr/bin/fish"
            },
            "sh": {
              "path": "/bin/sh"
            }
          },
          "terminal.integrated.profiles.osx": {
            "zsh": {
              "path": "/bin/zsh",
              "args": [
                "-l"
              ]
            },
            "bash": {
              "path": "/bin/bash",
              "args": [
                "-l"
              ]
            }
          },
          "terminal.integrated.profiles.windows": {
            "PowerShell": {
              "path": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
              "args": [
                "-NoLogo"
              ]
            },
            "Command Prompt": {
              "path": "C:\\Windows\\System32\\cmd.exe"
            },
            "Git Bash": {
              "path": "C:\\Program Files\\Git\\bin\\bash.exe",
              "args": [
                "--login",
                "-i"
              ]
            },
            "WSL": {
              "path": "C:\\Windows\\System32\\wsl.exe"
            }
          },
          "terminal.integrated.defaultProfile.windows": "WSL",
          "terminal.integrated.copyOnSelection": true,
          "git.openRepositoryInParentFolders": "always",
          "scm.alwaysShowRepositories": true,
          "extensions": {
            "recommendations": [
              "highagency.pencildev",
              "shd101wyy.markdown-preview-enhanced",
              "bierner.markdown-mermaid"
            ]
          },
          "extensions.ignoreRecommendations": true
        },
        "electron": {
          "windowOptions": {
            "width": 1380,
            "height": 880,
            "minWidth": 1000,
            "minHeight": 650,
            "titleBarStyle": "hiddenInset",
            "trafficLightPosition": {
              "x": 18,
              "y": 17
            }
          }
        }
      }
    }
  },
  "dependencies": {
    "@paddock/shell": "file:./paddock-shell",
    "@theia/core": "1.75.0",
    "@theia/editor": "1.75.0",
    "@theia/electron": "1.75.0",
    "@theia/filesystem": "1.75.0",
    "@theia/monaco": "1.75.0",
    "@theia/navigator": "1.75.0",
    "@theia/plugin-ext": "1.75.0",
    "@theia/plugin-ext-vscode": "1.75.0",
    "@theia/preferences": "1.75.0",
    "@theia/process": "1.75.0",
    "@theia/remote": "1.75.0",
    "@theia/scm": "1.75.0",
    "@theia/terminal": "1.75.0",
    "@theia/vsx-registry": "1.75.0",
    "@theia/workspace": "1.75.0",
    "xterm-addon-unicode11": "0.6.0"
  },
  "devDependencies": {
    "@theia/cli": "1.75.0",
    "electron": "42.8.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "scripts": {
    "build": "theia build --mode development",
    "rebuild": "theia rebuild:electron --cacheRoot .",
    "start": "node scripts/start.cjs",
    "smoke:shell": "node scripts/smoke-shell.cjs",
    "package:mac": "node scripts/package.cjs mac",
    "package:win": "node scripts/package.cjs win",
    "download:plugins": "theia download:plugins --rate-limit=15 --parallel=false",
    "test": "node --test paddock-shell/test/file-marks.test.js paddock-shell/test/tab-drop.test.js paddock-shell/test/tab-detach.test.js paddock-shell/test/work-model.test.js paddock-shell/test/work-presence.test.js paddock-shell/test/usage-model.test.js paddock-shell/test/agent-model.test.js paddock-shell/test/legacy-directory.test.js paddock-shell/test/layout-model.test.js paddock-shell/test/wsl-terminals.test.js paddock-shell/test/agent-account.test.js paddock-shell/test/windows-processes.test.js paddock-shell/test/cwd-report.test.js paddock-shell/test/window-fit.test.js paddock-shell/test/terminal-environment.test.js paddock-shell/test/git-environment.test.js paddock-shell/test/account-profiles.test.js paddock-shell/test/account-launch.test.js paddock-shell/test/account-session.test.js paddock-shell/test/terminal-replacement.test.js paddock-shell/test/emoji-width.test.js paddock-shell/test/account-browser.test.js paddock-shell/test/account-usage.test.js paddock-shell/test/codex-usage.test.js paddock-shell/test/usage-route.test.js paddock-shell/test/usage-panel.test.js paddock-shell/test/account-storage-access.test.js paddock-shell/test/account-access-dialog.test.js paddock-shell/test/statusbar-css.test.js paddock-shell/test/keyboard-layout.test.js"
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "vscode.git": "https://open-vsx.org/api/vscode/git/1.95.3/file/vscode.git-1.95.3.vsix",
    "vscode.git-base": "https://open-vsx.org/api/vscode/git-base/1.95.3/file/vscode.git-base-1.95.3.vsix",
    "vscode.media-preview": "https://open-vsx.org/api/vscode/media-preview/1.95.3/file/vscode.media-preview-1.95.3.vsix",
    "vscode.javascript": "https://open-vsx.org/api/vscode/javascript/1.95.3/file/vscode.javascript-1.95.3.vsix",
    "vscode.typescript": "https://open-vsx.org/api/vscode/typescript/1.95.3/file/vscode.typescript-1.95.3.vsix",
    "vscode.json": "https://open-vsx.org/api/vscode/json/1.95.3/file/vscode.json-1.95.3.vsix",
    "vscode.yaml": "https://open-vsx.org/api/vscode/yaml/1.95.3/file/vscode.yaml-1.95.3.vsix",
    "vscode.python": "https://open-vsx.org/api/vscode/python/1.95.3/file/vscode.python-1.95.3.vsix",
    "vscode.markdown": "https://open-vsx.org/api/vscode/markdown/1.95.3/file/vscode.markdown-1.95.3.vsix",
    "vscode.shellscript": "https://open-vsx.org/api/vscode/shellscript/1.95.3/file/vscode.shellscript-1.95.3.vsix",
    "vscode.html": "https://open-vsx.org/api/vscode/html/1.95.3/file/vscode.html-1.95.3.vsix",
    "vscode.css": "https://open-vsx.org/api/vscode/css/1.95.3/file/vscode.css-1.95.3.vsix",
    "vscode.scss": "https://open-vsx.org/api/vscode/scss/1.95.3/file/vscode.scss-1.95.3.vsix",
    "vscode.less": "https://open-vsx.org/api/vscode/less/1.95.3/file/vscode.less-1.95.3.vsix",
    "vscode.xml": "https://open-vsx.org/api/vscode/xml/1.95.3/file/vscode.xml-1.95.3.vsix",
    "vscode.rust": "https://open-vsx.org/api/vscode/rust/1.95.3/file/vscode.rust-1.95.3.vsix",
    "vscode.go": "https://open-vsx.org/api/vscode/go/1.95.3/file/vscode.go-1.95.3.vsix",
    "vscode.java": "https://open-vsx.org/api/vscode/java/1.95.3/file/vscode.java-1.95.3.vsix",
