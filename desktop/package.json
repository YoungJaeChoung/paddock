    "vscode.r": "https://open-vsx.org/api/vscode/r/1.95.3/file/vscode.r-1.95.3.vsix",
    "vscode.diff": "https://open-vsx.org/api/vscode/diff/1.95.3/file/vscode.diff-1.95.3.vsix",
