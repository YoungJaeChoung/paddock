{
  "private": true,
  "name": "paddock-desktop",
  "version": "0.1.0",
  "main": "lib/backend/electron-main.js",
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "Paddock",
        "defaultTheme": "dark",
        "preferences": {
          "workbench.colorTheme": "Paddock Dark",
          "terminal.integrated.fontFamily": "Consolas, Menlo, 'Droid Sans Mono', 'DejaVu Sans Mono', 'Malgun Gothic', 'Apple SD Gothic Neo', 'Noto Sans Mono CJK KR', monospace",
          "terminal.integrated.letterSpacing": 0,
          "terminal.integrated.lineHeight": 1.1,
          "editor.fontFamily": "Consolas, Menlo, 'Droid Sans Mono', 'DejaVu Sans Mono', 'Malgun Gothic', 'Apple SD Gothic Neo', 'Noto Sans Mono CJK KR', monospace",
          "editor.enablePreview": false,
          "editor.wordWrap": "on",
          "workbench.tree.indent": 20,
          "files.exclude": {
            "**/.git": true,
            "**/.svn": true,
            "**/.hg": true,
            "**/CVS": true,
            "**/.DS_Store": true,
            "**/Thumbs.db": true,
            "**/__pycache__": true
          },
          "git.autofetch": true,
          "window.titleBarStyle": "native",
          "terminal.integrated.profiles.linux": {
            "bash": {
              "path": "/bin/bash",
              "args": [
                "-l"
              ]
            },
            "zsh": {
              "path": "/usr/bin/zsh",
              "args": [
                "-l"
              ]
            },
            "fish": {
              "path": "/usr/bin/fish"
            },
            "sh": {
              "path": "/bin/sh"
            }
          },
          "terminal.integrated.profiles.osx": {
            "zsh": {
              "path": "/bin/zsh",
              "args": [
                "-l"
              ]
            },
            "bash": {
              "path": "/bin/bash",
              "args": [
                "-l"
              ]
            }
          },
          "terminal.integrated.profiles.windows": {
            "PowerShell": {
              "path": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
              "args": [
                "-NoLogo"
              ]
            },
            "Command Prompt": {
              "path": "C:\\Windows\\System32\\cmd.exe"
            },
            "Git Bash": {
              "path": "C:\\Program Files\\Git\\bin\\bash.exe",
              "args": [
                "--login",
                "-i"
              ]
            },
            "WSL": {
              "path": "C:\\Windows\\System32\\wsl.exe"
            }
          },
          "terminal.integrated.defaultProfile.windows": "Git Bash",
          "terminal.integrated.copyOnSelection": true,
          "git.openRepositoryInParentFolders": "always",
          "scm.alwaysShowRepositories": true,
          "extensions": {
            "recommendations": [
              "highagency.pencildev",
              "shd101wyy.markdown-preview-enhanced",
              "bierner.markdown-mermaid"
            ]
          },
          "extensions.ignoreRecommendations": true
        },
        "electron": {
          "windowOptions": {
            "width": 1380,
            "height": 880,
            "minWidth": 1000,
            "minHeight": 650,
            "titleBarStyle": "hiddenInset",
            "trafficLightPosition": {
              "x": 18,
              "y": 17
            }
          }
        }
      }
    }
  },
  "dependencies": {
    "@paddock/shell": "file:./paddock-shell",
    "@theia/core": "1.75.0",
    "@theia/editor": "1.75.0",
    "@theia/electron": "1.75.0",
    "@theia/filesystem": "1.75.0",
    "@theia/monaco": "1.75.0",
    "@theia/navigator": "1.75.0",
    "@theia/plugin-ext": "1.75.0",
    "@theia/plugin-ext-vscode": "1.75.0",
    "@theia/preferences": "1.75.0",
    "@theia/process": "1.75.0",
    "@theia/remote": "1.75.0",
    "@theia/scm": "1.75.0",
    "@theia/terminal": "1.75.0",
    "@theia/vsx-registry": "1.75.0",
    "@theia/workspace": "1.75.0"
  },
  "devDependencies": {
    "@theia/cli": "1.75.0",
    "electron": "42.8.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "scripts": {
    "build": "theia build --mode development",
    "rebuild": "theia rebuild:electron --cacheRoot .",
    "start": "node scripts/start.cjs",
    "smoke:shell": "node scripts/smoke-shell.cjs",
    "package:mac": "node scripts/package.cjs mac",
    "package:win": "node scripts/package.cjs win",
    "download:plugins": "theia download:plugins --rate-limit=15 --parallel=false",
    "test": "node --test paddock-shell/test/work-model.test.js paddock-shell/test/work-presence.test.js paddock-shell/test/usage-model.test.js paddock-shell/test/agent-model.test.js paddock-shell/test/legacy-directory.test.js paddock-shell/test/layout-model.test.js"
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "vscode.git": "https://open-vsx.org/api/vscode/git/1.95.3/file/vscode.git-1.95.3.vsix",
    "vscode.git-base": "https://open-vsx.org/api/vscode/git-base/1.95.3/file/vscode.git-base-1.95.3.vsix",
    "vscode.media-preview": "https://open-vsx.org/api/vscode/media-preview/1.95.3/file/vscode.media-preview-1.95.3.vsix"
  }
}
